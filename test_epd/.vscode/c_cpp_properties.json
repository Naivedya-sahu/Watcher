{
    "configurations": [
        {
            "name": "ESP-IDF",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/main",
                "${workspaceFolder}/components/**",
                "${workspaceFolder}/../components/**",
                "${workspaceFolder}/.vscode/intellisense_include/**",
                "${workspaceFolder}/build/config",
                "${workspaceFolder}/build/*/config",
                "$ENV{IDF_PATH}/components/**",
                "$ENV{IDF_PATH}/tools/cmake",
                "${workspaceFolder}/build/esp-idf/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "ESP_PLATFORM"
            ],
            "compilerPath": "${IDF_TOOLS_PATH}/tools/xtensa-esp32-elf/esp-12.2.0_20230208/xtensa-esp32-elf/bin/xtensa-esp32-elf-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/components",
                    "${workspaceFolder}/../components",
                    "$ENV{IDF_PATH}/components"
                ],
                "limitSymbolsToIncludedHeaders": false,
                "databaseFilename": "${workspaceFolder}/.vscode/.cppcheck"
            }
        }
    ],
    "version": 4
}
