# ============================================================
# Watcher v7.1 — ESP-IDF sdkconfig defaults
# Module: ESP32-S3-WROOM-1-N8R8 (8MB flash, 8MB OPI PSRAM)
# ============================================================

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM — disabled until IO35/36/37 conflict verified on real hardware
# To enable: set CONFIG_SPIRAM=y and CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM=n

# UART-only console for FTDI flashing/monitor on a bare module
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Keep USB console paths off by default to avoid routing ambiguity on bring-up
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_TINYUSB_CDC_ENABLED is not set

# CPU frequency
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Partition table — custom 8MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS tick rate — 1kHz for 1ms precision on pomodoro
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WiFi
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# OTA
CONFIG_OTA_ALLOW_HTTP=n
# Development only: allow HTTPS OTA without server cert verification
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# SPI flash
CONFIG_SPI_FLASH_USE_LEGACY_IMPL=n

# Bootloader log level
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# WebSocket support in esp_http_server (required by web_server component)
CONFIG_HTTPD_WS_SUPPORT=y

# HTTP server max URI handlers (default 8 — enough for REST + WS)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
