<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Watcher v7.1</title>
<style>*{box-sizing:border-box;margin:0;padding:0}:root{--bg:#0e0e0e;--bg2:#1a1a1a;--border:#2e2e2e;--accent:#e0e0e0;--dim:#666;--green:#4caf50;--red:#f44336;--yellow:#ffb300;--font:monospace}body.light{--bg:#fff;--bg2:#f5f5f5;--border:#e0e0e0;--accent:#1a1a1a;--dim:#999}body{background:var(--bg);color:var(--accent);font-family:var(--font);font-size:12px;display:flex;flex-direction:column;height:100vh}header{display:flex;justify-content:space-between;padding:10px 20px;border-bottom:1px solid var(--border);background:var(--bg2)}.logo{font-size:13px;font-weight:700}.container{display:flex;flex:1;overflow:hidden}.sidebar{width:140px;border-right:1px solid var(--border);background:var(--bg2);overflow-y:auto;padding:10px}.screen-btn{width:100%;padding:5px;background:var(--bg);border:1px solid var(--border);color:var(--accent);cursor:pointer;margin:2px 0;font-family:var(--font);font-size:11px}.screen-btn.active{background:var(--green);color:#000}.center-panel{flex:0 0 auto;padding:15px;display:flex;flex-direction:column;align-items:center;border-right:1px solid var(--border)}#epd-canvas{border:2px solid var(--border);width:400px;height:300px;background:#fff}.epd-info{margin-top:8px;font-size:10px;color:var(--dim)}.control-panel{width:240px;border-right:1px solid var(--border);background:var(--bg2);overflow-y:auto;padding:10px;font-size:11px}.control-section{display:none;margin-bottom:15px}.control-section.active{display:block}.control-title{font-size:9px;color:var(--dim);margin-bottom:8px;text-transform:uppercase}input[type="text"],input[type="number"],input[type="password"],select{width:100%;padding:4px;background:var(--bg);color:var(--accent);border:1px solid var(--border);font-family:var(--font);margin-bottom:6px;font-size:10px}button{padding:5px 8px;background:var(--bg);border:1px solid var(--border);color:var(--accent);font-family:var(--font);font-size:10px;cursor:pointer;margin:4px 0;width:100%}button.primary{background:var(--green);color:#000;border:1px solid var(--green)}button:hover{border-color:var(--accent)}.event-log{flex:1;border-top:1px solid var(--border);background:var(--bg2);display:flex;flex-direction:column}.log-content{flex:1;overflow-y:auto;padding:8px;font-size:9px;line-height:1.5;color:var(--dim)}.log-entry{margin:2px 0}.log-entry.ok{color:var(--green)}.log-entry.warn{color:var(--yellow)}.log-entry.error{color:var(--red)}.log-footer{padding:8px;border-top:1px solid var(--border);display:flex;gap:4px}.log-footer button{flex:1;padding:4px;font-size:9px}
</style>
</head>
<body>
<header><div class="logo">WATCHER v7.1</div><div><label><input type="checkbox" id="theme-toggle"> DARK/LIGHT</label> <span id="status-bar">Ready</span></div></header>
<div class="container">
<div class="sidebar"><button class="screen-btn active" data-screen="clock">Clock</button><button class="screen-btn" data-screen="pomodoro">Pomodoro</button><button class="screen-btn" data-screen="alarm">Alarm</button><button class="screen-btn" data-screen="calendar">Calendar</button><button class="screen-btn" data-screen="tasks">Tasks</button><button class="screen-btn" data-screen="settings">Settings</button></div>
<div class="center-panel"><canvas id="epd-canvas" width="400" height="300"></canvas><div class="epd-info" id="epd-info">—</div></div>
<div class="control-panel">
<div class="control-section active" data-config="clock"><div class="control-title">Clock</div><select id="cfg-time-format"><option>24h</option><option>12h</option></select><button id="btn-save-clock">Save</button></div>
<div class="control-section" data-config="pomodoro"><div class="control-title">Pomodoro</div><input type="number" id="cfg-pomo-focus" value="25"><input type="number" id="cfg-pomo-break" value="5"><input type="number" id="cfg-pomo-long" value="15"><input type="number" id="cfg-pomo-cycles" value="4"><button id="btn-save-pomo">Save</button><button id="btn-pomo-toggle">Toggle</button><button id="btn-pomo-reset">Reset</button></div>
<div class="control-section" data-config="settings"><div class="control-title">Settings</div><input type="text" id="cfg-wifi-ssid" placeholder="SSID"><input type="password" id="cfg-wifi-pass" placeholder="Pass"><input type="text" id="cfg-device-name" placeholder="Name"><input type="text" id="cfg-timezone" placeholder="TZ"><input type="text" id="cfg-ota-url" placeholder="OTA URL"><input type="number" id="cfg-sleep-timeout" value="0"><label><input type="checkbox" id="cfg-buzzer"> Buzzer</label><label><input type="checkbox" id="cfg-dark"> Dark</label><button id="btn-save-settings">Save</button><button id="btn-ota-trigger" class="primary">OTA</button></div>
<div class="control-section" data-config="alarm"><div class="control-title">Alarm - via device</div></div>
<div class="control-section" data-config="calendar"><div class="control-title">Calendar - via device</div></div>
<div class="control-section" data-config="tasks"><div class="control-title">Tasks - via device</div></div>
</div>
<div class="event-log"><div class="log-content" id="log-content"></div><div class="log-footer"><button id="btn-refresh-epd">Refresh</button><button id="btn-ota-check">OTA</button><button id="btn-clear-log">Clear</button></div></div>
</div>
<script>
const EPD_W=400,EPD_H=300,FB_BYTES=EPD_W*EPD_H/8;let currentScreen='clock',autoRefreshTimer=null,logEntries=[];
function setStatus(msg,t=''){document.getElementById('status-bar').textContent=msg}
function log(msg,type=''){logEntries.unshift(`[${new Date().toLocaleTimeString()}] ${msg}`);if(logEntries.length>50)logEntries.pop();renderLog()}
function renderLog(){const c=document.getElementById('log-content');c.innerHTML=logEntries.map(e=>`<div class="log-entry ${e.includes('Error')?'error':e.includes('OTA')?'warn':'ok'}">${e}</div>`).join('')}
async function sendCmd(p){const r=await fetch('/api/cmd',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});if(!r.ok)throw new Error(r.status);return await r.json()}
document.getElementById('theme-toggle').onchange=function(){document.body.classList.toggle('light',this.checked)};
document.querySelectorAll('.screen-btn').forEach(b=>{b.onclick=async function(){try{await sendCmd({cmd:'screen',screen:this.dataset.screen});document.querySelectorAll('.screen-btn').forEach(x=>x.classList.remove('active'));this.classList.add('active');document.querySelectorAll('.control-section').forEach(s=>s.classList.remove('active'));document.querySelector('[data-config="'+this.dataset.screen+'"]').classList.add('active');await refreshEpd();log('Screen: '+this.dataset.screen,'ok')}catch(e){log('Error: '+e.message,'error')}}});
function drawBitmap(b,c){const x=c.getContext('2d'),d=x.createImageData(EPD_W,EPD_H),o=d.data;for(let y=0;y<EPD_H;y++)for(let x=0;x<EPD_W;x++){const v=((b[y*(EPD_W>>3)+(x>>3)]>>(7-(x&7)))&1)?255:0,i=(y*EPD_W+x)*4;o[i]=o[i+1]=o[i+2]=v;o[i+3]=255}x.putImageData(d,0,0)}
async function refreshEpd(){try{const [br,sr]=await Promise.all([fetch('/api/bitmap'),fetch('/api/state')]);if(!br.ok)throw new Error('bitmap');const b=new Uint8Array(await br.arrayBuffer());drawBitmap(b,document.getElementById('epd-canvas'));let c=0;for(let i=0;i<b.length;i++){let v=~b[i]&0xFF;v=v-((v>>1)&0x55);v=(v&0x33)+((v>>2)&0x33);c+=(((v+(v>>4))&0x0F)*0x01010101)>>24}const t=EPD_W*EPD_H;document.getElementById('epd-info').textContent=c+' black, '+(t-c)+' white ('+((c/t)*100).toFixed(1)+'%)';if(sr.ok){const s=await sr.json();if(s.h24!==undefined)document.getElementById('cfg-time-format').value=s.h24?'24h':'12h';if(s.ssid)document.getElementById('cfg-wifi-ssid').value=s.ssid||'';if(s.ota_url)document.getElementById('cfg-ota-url').value=s.ota_url||'';setStatus(s.screen+' - OTA: '+(s.ota_running?'running':'idle'))}log('EPD updated','ok')}catch(e){log('EPD error: '+e.message,'error')}}
document.getElementById('btn-refresh-epd').onclick=()=>refreshEpd();
document.getElementById('btn-ota-check').onclick=async()=>{const r=await fetch('/api/state'),s=await r.json();log(s.ota_running?'OTA running':'OTA idle','warn')};
document.getElementById('btn-clear-log').onclick=()=>{logEntries=[];renderLog();log('Log cleared','ok')};
document.getElementById('btn-save-clock').onclick=async()=>{await sendCmd({cmd:'cfg',key:'h24',nval:document.getElementById('cfg-time-format').value==='24h'});log('Saved','ok')};
document.getElementById('btn-save-pomo').onclick=async()=>{await sendCmd({cmd:'cfg',key:'pomo_config',nval:{focus:parseInt(document.getElementById('cfg-pomo-focus').value),brk:parseInt(document.getElementById('cfg-pomo-break').value),lng:parseInt(document.getElementById('cfg-pomo-long').value),cycles:parseInt(document.getElementById('cfg-pomo-cycles').value)}});log('Saved','ok')};
document.getElementById('btn-pomo-toggle').onclick=async()=>{await sendCmd({cmd:'pomo_toggle'});await refreshEpd()};
document.getElementById('btn-pomo-reset').onclick=async()=>{await sendCmd({cmd:'pomo_reset'});await refreshEpd()};
document.getElementById('btn-save-settings').onclick=async()=>{try{const s=document.getElementById('cfg-wifi-ssid').value,p=document.getElementById('cfg-wifi-pass').value,d=document.getElementById('cfg-device-name').value,tz=document.getElementById('cfg-timezone').value,u=document.getElementById('cfg-ota-url').value,b=document.getElementById('cfg-buzzer').checked;if(s)await sendCmd({cmd:'cfg',key:'ssid',val:s});if(p)await sendCmd({cmd:'cfg',key:'pass',val:p});if(d)await sendCmd({cmd:'cfg',key:'devname',val:d});if(tz)await sendCmd({cmd:'cfg',key:'tz',val:tz});if(u)await sendCmd({cmd:'cfg',key:'ota_url',val:u});await sendCmd({cmd:'cfg',key:'buzzer',nval:b});log('Saved','ok')}catch(e){log('Error: '+e.message,'error')}};
document.getElementById('btn-ota-trigger').onclick=async()=>{try{await sendCmd({cmd:'ota'});log('OTA started','ok');await refreshEpd()}catch(e){log('OTA error: '+e.message,'error')}};
window.onload=async()=>{log('Ready','ok');await refreshEpd();autoRefreshTimer=setInterval(refreshEpd,5000)};
</script>
</body>
</html>
